# Backend environment variables (copy to backend/.env)
# Download the service account JSON from Firebase Console → Project Settings → Service accounts → Generate new private key

FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=pingmytherapist
FIREBASE_STORAGE_BUCKET=pingmytherapist.firebasestorage.app

# Local upload fallback (used when Firebase Storage is unavailable)
LOCAL_UPLOADS_DIR=./local-uploads
LOCAL_UPLOADS_URL_BASE=http://localhost:8001/uploads
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3002

# Redis + Celery (required for AI background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# One-time initial admin bootstrap (set ENABLED=true only temporarily)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_SECRET=

# OpenRouter AI (optional)
OPENROUTER_API_KEY=
